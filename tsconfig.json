{
  "extends": "@react-native/typescript-config",
  "compilerOptions": {
    "types": ["jest"],
    "baseUrl": ".",
    "paths": {
      "@containers/*": ["src/containers/*"],
      "@repositories/*": ["src/repositories/*"],
      "@stores/*": ["src/stores/*"],
      "@db/*": ["src/db/*"]
    }
  },
  "include": ["**/*.ts", "**/*.tsx"],
  "exclude": ["**/node_modules", "**/Pods"]
}
